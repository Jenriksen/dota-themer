# Dota Themer - environment configuration
#
# Copy this file to `.env` for docker-compose, or export the variables
# directly. Everything is env-configurable so deployments can be
# rendered as IaC (Terraform/ECS/Compose) with no file edits.
#
# Local debugging: NO variables are required. An empty environment
# runs SQLite on ./data/dota.db (created and auto-populated from the
# JSON files on first use) with no S3 traffic at all.

# Required for Discord bot
DISCORD_TOKEN=your_discord_bot_token_here

# Storage (#52): SQLite is the only backend. The JSON files in
# ./data are imported once into dota.db when it does not exist yet.

# S3 snapshots (optional): setting DOTA_THEMER_S3_BUCKET enables the
# snapshot pattern - pull at startup (only when no local dota.db
# exists), push after every theme save. Leave empty for local debugging.
DOTA_THEMER_S3_BUCKET=
DOTA_THEMER_S3_PREFIX=

# Database location (optional): directory for dota.db and the JSON
# seed files. Set this when the writable data path differs from the
# packaged ./data directory (e.g. a mounted volume). The same path is
# used for the S3 snapshot push/pull. Defaults to ./data.
#DOTA_THEMER_DATA_DIR=

# Lane duo pair stats (optional): theme suggestions include the best
# hero duos per lane, built from OpenDota publicMatches. Refreshed at
# startup and daily; pair counts decay so stale patch data fades out.
# MIN_RANK: minimum rank tier of sampled matches (10-80; 50 = high
#   Divine and up, 80 = Immortal).
# PAGES: publicMatches pages (100 matches each) fetched per refresh.
DOTA_THEMER_COMBO_MIN_RANK=50
DOTA_THEMER_COMBO_PAGES=120

# AWS credentials (only needed when S3 is enabled and not on an
# EC2/ECS IAM role - boto3 picks up roles automatically)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_DEFAULT_REGION=

# Logging configuration (optional)
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=logs/dota-themer.log

# Environment name (optional)
ENV=development
